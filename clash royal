const cards=[['Рыцарь','⚔️',3,110,16],['Лучницы','🏹',3,75,20],['Гигант','🗿',5,240,12],['Стрелы','🏹',3,0,55],['Гоблины','🗡️',2,55,20],['Миньоны','🪽',3,90,20],['Бомбёр','💣',2,60,35],['Огненный шар','🔥',4,0,70],['Принц','🐎',5,140,28],['Ледяной дух','❄️',1,30,18],['Пушка','💣',3,100,26],['Валькирия','🪓',4,155,21],['Летучие мыши','🦇',2,45,16],['Голем','🪨',8,340,18],['Молния','⚡',6,0,100],['Охотник','🎯',4,105,29]];
const cardImages=["data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,"];let state=JSON.parse(localStorage.getItem('royalArenaSave')||'null')||{gold:500,gems:50,trophies:0,wins:0,crowns:0,owned:[0,1,2,3,4,5,6,7],deck:[0,1,2,3,4,5,6,7],levels:{},lastChest:0};if(!state.starterV2){state.owned=[0,1,2,3,4,5,6,7];state.deck=[0,1,2,3,4,5,6,7];state.starterV2=true;localStorage.setItem('royalArenaSave',JSON.stringify(state))}let selectedCard=0,battle=null,timer=null;const $=id=>document.getElementById(id);function save(){localStorage.setItem('royalArenaSave',JSON.stringify(state));refresh()}function lobbyInfo(message){alert(message)}
function refresh(){['gold','gems','trophies','wins','crowns'].forEach(x=>$(x).textContent=state[x]);$('deckcount').textContent=state.deck.length;renderCards()}function cardEl(id,fn,active=false){let c=cards[id],d=document.createElement('div');d.className='card'+(active?' selected':'')+(id>=8?' locked':'');let pic=cardImages[id]||'';d.innerHTML=`<span class="cost">${c[2]}</span>${pic?`<img class="cardpic" src="${pic}">`:`<div class="fallbackpic">🔒</div>`}<span class="cardname">${c[0]}</span><small>Уровень ${state.levels[id]||1}</small>`;d.onclick=fn;return d}
function renderCards(){let a=$('collectionCards'),d=$('deck');a.innerHTML='';d.innerHTML='';state.deck.forEach(id=>d.append(cardEl(id,()=>toggleDeck(id),selectedCard===id)));cards.forEach((c,id)=>a.append(cardEl(id,()=>{if(!state.owned.includes(id))return alert('Карта откроется на следующей арене');selectedCard=id;toggleDeck(id)},state.deck.includes(id))))}function toggleDeck(id){selectedCard=id;if(state.deck.includes(id))state.deck=state.deck.filter(x=>x!==id);else if(state.deck.length<8)state.deck.push(id);else alert('В колоде максимум 8 карт');save()}function upgrade(){if(state.gold<100)return alert('Не хватает золота');state.gold-=100;state.levels[selectedCard]=(state.levels[selectedCard]||1)+1;save()}function tab(id){if(id==='battle'&&!battle)return startBattle();['home','collection','shop','battle'].forEach(x=>$(x).classList.toggle('hidden',x!==id));refresh()}function openChest(paid){if(paid){if(state.gold<150)return alert('Не хватает золота');state.gold-=150}else if(Date.now()-state.lastChest<60000)return alert('Сундук ещё закрыт. Подожди немного!');else state.lastChest=Date.now();let prize=60+Math.floor(Math.random()*100),id=Math.floor(Math.random()*8);state.gold+=prize;if(!state.owned.includes(id))state.owned.push(id);save();alert(`🎁 +${prize} золота! Карта: ${cards[id][0]} ${cards[id][1]}`)}function buyGold(){if(state.gems<100)return alert('Нужно 100 кристаллов');state.gems-=100;state.gold+=500;save()}function buyCard(){if(state.gold<80)return alert('Мало золота');state.gold-=80;if(!state.owned.includes(3))state.owned.push(3);save();alert('Карта Стрелы получена!')}
function startBattle(){if(state.deck.length===0)return alert('Добавь карты в колоду');if(timer)clearInterval(timer);battle={time:180,mana:5,enemyMana:5,units:[],hp:{e0:600,e1:600,e2:1000,p0:600,p1:600,p2:1000},selected:0,enemyTick:0};tab('battle');drawHand();timer=setInterval(tick,200);drawBattle()}function leaveBattle(){if(timer)clearInterval(timer);timer=null;battle=null;tab('home')}function drawHand(){let h=$('hand');h.innerHTML='';state.deck.slice(0,8).forEach((id,i)=>h.append(cardEl(id,()=>{battle.selected=i;drawHand();$('notice').textContent='Коснись своей половины арены'},battle.selected===i)))}function placeUnit(e){if(!battle)return;let r=$('arena').getBoundingClientRect(),x=(e.clientX-r.left)/r.width*100,y=(e.clientY-r.top)/r.height*100;if(y<57){$('notice').textContent='Размещай войска на своей половине!';return}let id=state.deck[battle.selected],c=cards[id];if(battle.mana<c[2]){$('notice').textContent='Недостаточно эликсира';return}battle.mana-=c[2];spawn(id,x,y,'p');$('notice').textContent=`${c[0]} выходит на арену!`;drawBattle()}function spawn(id,x,y,team){let c=cards[id],level=state.levels[id]||1;if(c[3]===0){let targets=team==='p'?['e0','e1','e2']:['p0','p1','p2'];let t=targets.filter(k=>battle.hp[k]>0).sort((a,b)=>battle.hp[a]-battle.hp[b])[0];if(t)battle.hp[t]-=c[4]*3;return}battle.units.push({id,x,y,team,hp:c[3]*(1+.1*(level-1)),damage:c[4]*(1+.1*(level-1)),cool:0})}function tick(){if(!battle)return;let b=battle;b.time-=.2;b.mana=Math.min(10,b.mana+.085);b.enemyMana=Math.min(10,b.enemyMana+.08);b.enemyTick++;if(b.enemyTick%22===0){let possible=cards.map((c,i)=>i).filter(i=>cards[i][2]<=b.enemyMana);if(possible.length){let id=possible[Math.floor(Math.random()*possible.length)];b.enemyMana-=cards[id][2];spawn(id,Math.random()<.5?22:78,25,'e')}}for(let u of b.units){let foes=b.units.filter(v=>v.team!==u.team&&v.hp>0);let nearest=foes.sort((a,c)=>Math.hypot(a.x-u.x,a.y-u.y)-Math.hypot(c.x-u.x,c.y-u.y))[0];let dist=nearest?Math.hypot(nearest.x-u.x,nearest.y-u.y):999;let target=nearest&&dist<11?nearest:null;let towerIds=u.team==='p'?['e0','e1','e2']:['p0','p1','p2'];let towers=towerIds.filter(k=>b.hp[k]>0);let tower=towers.map(k=>{let el=$(k),r=el.getBoundingClientRect(),ar=$('arena').getBoundingClientRect();return{k,x:(r.left+r.width/2-ar.left)/ar.width*100,y:(r.top+r.height/2-ar.top)/ar.height*100}}).sort((a,c)=>Math.hypot(a.x-u.x,a.y-u.y)-Math.hypot(c.x-u.x,c.y-u.y))[0];let tx=target?target.x:tower?.x,ty=target?target.y:tower?.y;if(tx===undefined)continue;let d=Math.hypot(tx-u.x,ty-u.y);if(d>5){u.x+=(tx-u.x)/d*.45;u.y+=(ty-u.y)/d*.45}else if(u.cool<=0){if(target)target.hp-=u.damage;else b.hp[tower.k]-=u.damage;u.cool=5}u.cool--;if(u.hp>0){let enemyTowers=u.team==='p'?['e0','e1','e2']:['p0','p1','p2'];for(let k of enemyTowers){if(b.hp[k]<=0)continue;let el=$(k),r=el.getBoundingClientRect(),ar=$('arena').getBoundingClientRect(),px=(r.left+r.width/2-ar.left)/ar.width*100,py=(r.top+r.height/2-ar.top)/ar.height*100;if(Math.hypot(px-u.x,py-u.y)<18)u.hp-=1.6}}}b.units=b.units.filter(u=>u.hp>0);if(b.time<=0||b.hp.e2<=0||b.hp.p2<=0||(!b.hp.e0&&!b.hp.e1)||(!b.hp.p0&&!b.hp.p1))return finish();drawBattle()}function drawBattle(){if(!battle)return;let b=battle;$('clock').textContent=`${String(Math.floor(b.time/60)).padStart(2,'0')}:${String(Math.ceil(b.time%60)).padStart(2,'0')}`;$('mana').textContent=Math.floor(b.mana);$('manaFill').style.width=b.mana*10+'%';let pc=['e0','e1','e2'].filter(k=>b.hp[k]<=0).length,ec=['p0','p1','p2'].filter(k=>b.hp[k]<=0).length;$('score').textContent=`${pc} : ${ec}`;Object.entries(b.hp).forEach(([k,v])=>{$(k).querySelector('.hp').textContent=Math.max(0,Math.ceil(v))+' HP';$(k).style.opacity=v<=0?.3:1});$('arena').querySelectorAll('.unit').forEach(x=>x.remove());for(let u of b.units){let el=document.createElement('div');el.className='unit';el.style.left=u.x+'%';el.style.top=u.y+'%';el.style.filter=u.team==='e'?'drop-shadow(0 0 5px red)':'drop-shadow(0 0 5px blue)';el.innerHTML=(cardImages[u.id]?`<img src="${cardImages[u.id]}" style="width:38px;height:42px;object-fit:cover;border-radius:50%">`:cards[u.id][1])+`<small>${Math.ceil(u.hp)}</small>`;$('arena').append(el)}}function finish(){let b=battle,pc=['e0','e1','e2'].filter(k=>b.hp[k]<=0).length,ec=['p0','p1','p2'].filter(k=>b.hp[k]<=0).length;let player=pc>ec||(pc===ec&&b.hp.e2<b.hp.p2);if(player){state.wins++;state.trophies+=25;state.gold+=100;state.crowns+=Math.max(1,pc)}else state.trophies=Math.max(0,state.trophies-10);save();leaveBattle();alert(player?'🏆 ПОБЕДА! +25 кубков и +100 золота':'⚔️ Поражение. Попробуй другую колоду!')}refresh();
</script></html>
